# Copy privately to /opt/oasis-library/env, owned by root, mode 0600.
# This is literal systemd EnvironmentFile syntax, not a shell script.
DJANGO_SETTINGS_MODULE=dlms.device_settings
OASIS_DEVICE_DATA_ROOT=/opt/oasis-library/data
OASIS_DEVICE_SECRET_KEY_FILE=/opt/oasis-library/operator/secret.key

# Optional PRIVATE Tailscale Serve administrator origin. Leave empty for SSH
# localhost access only. This does not configure a proxy or expose a route.
# Only one canonical https://<tailnet-name>.ts.net:8443 origin is accepted.
OASIS_DEVICE_ADMIN_ORIGIN=

# Optional existing-station adapter. Leave the worker OFF until the real
# explicit reviewed manifest and maintenance runtime are configured.
# These example paths do not approve or select a published station release.
OASIS_INDEXING_STATION_ROOT=/opt/kuwala/current/app
OASIS_INDEXING_PYTHON=/opt/kuwala/venv/bin/python
OASIS_INDEXING_MANIFEST=
OASIS_INDEXING_MODEL=nomic-embed-text:latest
OASIS_INDEXING_EMBED_URL=http://127.0.0.1:11434

# Optional absolute dependency directory from the EXISTING PDF maintenance
# profile. Set the actual reviewed on-device path only if required by that
# runtime; no package installation or model download is performed by a job.
OASIS_INDEXING_DEPENDENCY_PATH=
